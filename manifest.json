{
  "name": "React Chrome Side Panel",
  "description": "A Chrome Extension Side Panel built with React.",
  "version": "0.1",
  "manifest_version": 3,
  "action": {
    "default_title": "Open Side Panel"
  },
  "permissions": ["sidePanel"],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "index.html"
  }

}